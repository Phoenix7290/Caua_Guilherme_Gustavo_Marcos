# Provedor LLM compatível com OpenAI (Groq, Ollama local, etc.)
# Opção 1 — Groq (https://console.groq.com/):
GROQ_API_KEY="sua-chave-groq-aqui"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-20b"

# Opção 2 — Ollama local (sobrescreve GROQ_* se definido):
# LLM_API_KEY="ollama"
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_MODEL="qwen3:8b"

# Endpoint da Customer Support Intent API (local ou Raspberry Pi)
SUPPORTDESK_API_URL="https://supportdesk-api.marcosryan.com"
SUPPORTDESK_API_USERNAME="alice"
SUPPORTDESK_API_PASSWORD="sua-senha-api-aqui"

# Opcional: informar um JWT já emitido em vez de autenticar com usuário/senha
# SUPPORTDESK_JWT_TOKEN=""
