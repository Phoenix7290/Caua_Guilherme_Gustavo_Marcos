# Chave da API Groq (https://console.groq.com/)
GROQ_API_KEY="sua-chave-groq-aqui"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-20b"

# Endpoint da Customer Support Intent API (local ou Raspberry Pi)
SUPPORTDESK_API_URL="http://localhost:8000"
SUPPORTDESK_API_USERNAME="alice"
SUPPORTDESK_API_PASSWORD="sua-senha-api-aqui"

# Opcional: informar um JWT já emitido em vez de autenticar com usuário/senha
# SUPPORTDESK_JWT_TOKEN=""
